# ==============================================================================
# Amoudi Financial Management - Local Development Environment Variables
# ==============================================================================
# Copy this file to .env or export these variables in your shell environment.
# Never commit real credentials or production secrets to source control.

# Application Profile & Server
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=amoudi_financial
DB_USERNAME=postgres
DB_PASSWORD=postgres

# CORS Configuration (Comma-separated allowed origins for frontend applications)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# MinIO S3-Compatible Object Storage (Planned for raw Excel files and payment receipts)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=amoudi_secret_key
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# JWT Authentication Configuration
# In production, generate a secure 256-bit+ key: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Initial Admin User Provisioning (Disabled by default in production)
INITIAL_USER_ENABLED=true
INITIAL_USER_USERNAME=admin
INITIAL_USER_PASSWORD=Admin@12345
INITIAL_USER_FULL_NAME=System Administrator
INITIAL_USER_ROLE=GENERAL_MANAGER
